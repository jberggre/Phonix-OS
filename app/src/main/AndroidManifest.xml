<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The first-run flow saves a real Wi-Fi network through WifiManager. Android 10+ only
         allows that for system apps and DPCs, and provision.sh makes Phonix the device owner,
         so the restriction does not apply to this app. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Granted to itself by the device owner (DevicePolicyManager.setPermissionGrantState) so
         the connected SSID can be shown. Phonix does not scan for networks and does not turn
         location services on; without this permission Android redacts the SSID. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 13+ Wi-Fi APIs; harmless on the Android 12 units this build ships on. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Required on Android 14+ for the read-only Phone Screen capture service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The manual updater downloads a verified APK and hands it to Android's installer, which
         still asks for confirmation. There is no silent install path. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets Phonix paint its own wallpaper onto the device so DeX/lock screen match the desktop -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Granted once by provision.sh; lets the Privacy Hub write Private DNS directly instead
         of only sending the customer to the Settings screen. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!--
            DeX / large-screen requirements:
              * resizeableActivity=true so the window manager treats Phonix as a real
                desktop app on an external display instead of confining it to a
                phone-sized window.
              * NO android:screenOrientation. A locked orientation makes Samsung's
                desktop mode fall back to "designed for phone screens" behaviour.
              * configChanges covers every size change so resizing a DeX window does
                not recreate the activity (and lose desktop state).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!--
                    HOME is intentionally NOT declared right now.
                    Samsung DeX classifies HOME/launcher apps as "designed for phone screens"
                    and refuses to window them on the external display (am start returns
                    status 102). Keeping HOME off the desktop activity is what lets it run
                    as a real DeX window; boot-to-desktop will be handled by a separate,
                    thin launcher activity once that trade-off is decided.
                -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
                DeX caption bar: not removable from the app. Samsung's documented
                com.samsung.android.dex.launchwidth/launchheight=0 and the optional
                transient_bar_delay key were both added, measured on the unit, and had no
                effect, so they are not carried. See docs/LINUX.md.
            -->
        </activity>

        <service
            android:name=".service.LinuxServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:ignore="ForegroundServicePermission" />

        <!-- Opens the desktop on the HDMI/DeX monitor, at boot and whenever one appears -->
        <service
            android:name=".service.DesktopAutoLaunchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Real, read-only screen mirror. Started only after the system capture-consent dialog. -->
        <service
            android:name=".service.ScreenMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            Device-owner target for provision.sh (`dpm set-device-owner`).
            Required for permanent HOME, keyguard disable, boot-to-desktop and
            silent package management on a machine with no usable screen.
        -->
        <receiver
            android:name=".receiver.PhonixDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
