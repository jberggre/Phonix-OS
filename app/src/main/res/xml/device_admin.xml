<?xml version="1.0" encoding="utf-8"?>
<!--
    Policies requested by PhonixDeviceAdminReceiver.

    Deliberately minimal:
      force-lock     - lets the desktop lock/unlock the machine without the
                       power button, which is usually inaccessible once the
                       phone is sealed inside a Mini PC shell.
      disable-camera - cameras are physically removed from these units, so the
                       policy keeps any residual camera surface dead.
      wipe-data      - lets a unit that comes back to the bench be erased from
                       the Privacy Hub. Device owner also blocks the Settings
                       reset path, so without this a returned unit would be
                       stuck with the previous owner's data.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <disable-camera />
        <wipe-data />
    </uses-policies>
</device-admin>
